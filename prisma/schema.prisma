// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Roles (Sheet 4: User Roles) ---
// VENDOR_EXTERNAL is intentionally not a login-capable role: vendors never
// authenticate, they only ever interact through a tokenized VRF link.
enum Role {
  FINANCE_TEAM
  FINANCE_HEAD_CFO
  FOUNDER_CEO
  PRODUCTION_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE_CONTRACTOR
  REPORTING_MANAGER
  ADMIN_IT
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DocumentType {
  PAN
  GST
  MSME
  CANCELLED_CHEQUE
  AGREEMENT
  OTHER
}

enum VrfStatus {
  PENDING
  EDITS_REQUESTED
  APPROVED
  REJECTED
}

// --- Production / Budgeting (Sheet 3: Project, Production Budget, PO) ---
enum ProjectType {
  FILM
  SERIES
  SHORT
  OTHER
}

enum ProjectStatus {
  PRE_PRODUCTION
  PRODUCTION
  POST
  RELEASED
  ARCHIVED
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVISION
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_FULFILLED
  CLOSED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewedVrfSubmissions VrfSubmission[] @relation("VrfReviewedBy")
  auditLogs              AuditLog[]
}

model Vendor {
  id      String @id @default(cuid())
  // Auto-generated on VRF approval or manual create, e.g. V-2026-0001
  vendorCode String @unique

  legalName      String
  tradeName      String?
  pan            String
  gstin          String[] @default([])
  placeOfSupply  String?
  placeOfInvoice String?
  msmeStatus     Boolean  @default(false)

  addressLine String?
  city        String?
  state       String?
  pincode     String?

  // Bank details: masked on read by lib/rbac.ts unless the viewer has Edit/Approve access.
  bankAccountNo   String
  bankName        String
  ifsc            String
  beneficiaryName String

  category      String
  paymentTerms  String?
  tdsSection    String?
  lowerTdsFlag  Boolean @default(false)
  defaultLedger String?

  status VendorStatus @default(ACTIVE)

  documents      VendorDocument[]
  vrfSubmission  VrfSubmission?
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pan])
  @@index([status])
}

model VendorDocument {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  fileName   String
  expiryDate DateTime?
  uploadedAt DateTime     @default(now())

  @@index([vendorId])
}

// A vendor's self-submitted registration, reached only via `token` (no login).
model VrfSubmission {
  id           String  @id @default(cuid())
  token        String  @unique
  invitedEmail String?

  // Mirrors the Vendor fields above; kept as JSON until approval so a
  // rejected/edits-requested submission never touches the Vendor table.
  formData Json

  status         VrfStatus @default(PENDING)
  // Null until the vendor first submits the form; set again on each resubmit.
  submittedAt    DateTime?
  reviewerNotes  String?
  reviewedByUserId String?
  reviewedBy     User?     @relation("VrfReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt     DateTime?

  // Set once approved and the Vendor record is created from this submission.
  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  documents VrfDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VrfDocument {
  id              String        @id @default(cuid())
  vrfSubmissionId String
  vrfSubmission   VrfSubmission @relation(fields: [vrfSubmissionId], references: [id], onDelete: Cascade)
  type            DocumentType
  fileUrl         String
  fileName        String
  uploadedAt      DateTime      @default(now())

  @@index([vrfSubmissionId])
}

// Master list of content productions (Sheet 3: Project / Show Master).
model Project {
  id           String        @id @default(cuid())
  code         String        @unique // e.g. PRJ-2026-001
  title        String
  type         ProjectType
  genre        String?
  status       ProjectStatus @default(PRE_PRODUCTION)
  startDate    DateTime?
  endDate      DateTime?
  businessUnit String?
  producer     String?
  budgetOwnerUserId String?
  currency     String        @default("INR")
  commissioned Boolean       @default(false)

  budgets        BudgetHeader[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A versioned budget for a project. At most one APPROVED header per project.
model BudgetHeader {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int
  status          BudgetStatus @default(DRAFT)
  notes           String?
  approvedByUserId String?
  approvedAt      DateTime?

  lines BudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}

model BudgetLine {
  id             String       @id @default(cuid())
  budgetHeaderId String
  budgetHeader   BudgetHeader @relation(fields: [budgetHeaderId], references: [id], onDelete: Cascade)
  department     String
  category       String
  ledger         String?
  description    String
  approvedAmount Decimal      @db.Decimal(14, 2)
  currency       String       @default("INR")
  sortOrder      Int          @default(0)

  poLines PoLine[]

  @@index([budgetHeaderId])
}

// Formal commitment to a vendor against a project's budget (Sheet 3: PO).
model PurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique // e.g. PO-2026-0001
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  status           PoStatus @default(DRAFT)
  deliveryDate     DateTime?
  notes            String?
  // Set when a Finance Head knowingly approves a PO that exceeds available budget.
  budgetOverride   Boolean  @default(false)
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?

  lines PoLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([vendorId])
  @@index([status])
}

model PoLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // The budget line this line commits against (Budget-vs-Actuals link).
  budgetLineId    String?
  budgetLine      BudgetLine?   @relation(fields: [budgetLineId], references: [id])
  description     String
  qty             Decimal       @db.Decimal(12, 2)
  rate            Decimal       @db.Decimal(14, 2)
  taxPct          Decimal?      @db.Decimal(5, 2)
  amount          Decimal       @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([budgetLineId])
}

// Immutable trail per Sheet 6's "Audit-first" principle.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
