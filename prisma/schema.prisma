// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Roles (Sheet 4: User Roles) ---
// VENDOR_EXTERNAL is intentionally not a login-capable role: vendors never
// authenticate, they only ever interact through a tokenized VRF link.
enum Role {
  FINANCE_TEAM
  FINANCE_HEAD_CFO
  FOUNDER_CEO
  PRODUCTION_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE_CONTRACTOR
  REPORTING_MANAGER
  ADMIN_IT
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DocumentType {
  PAN
  GST
  MSME
  CANCELLED_CHEQUE
  AGREEMENT
  OTHER
}

enum VrfStatus {
  PENDING
  EDITS_REQUESTED
  APPROVED
  REJECTED
}

// --- Production / Budgeting (Sheet 3: Project, Production Budget, PO) ---
enum ProjectType {
  FILM
  SERIES
  SHORT
  OTHER
}

enum ProjectStatus {
  PRE_PRODUCTION
  PRODUCTION
  POST
  RELEASED
  ARCHIVED
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVISION
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_FULFILLED
  CLOSED
  CANCELLED
}

// --- Script Breakdown (Phase B) ---
enum SceneInt {
  INT
  EXT
  INT_EXT
}

enum SceneTime {
  DAY
  NIGHT
  DAWN
  DUSK
}

enum ElementCategory {
  CAST
  EXTRAS
  PROPS
  WARDROBE
  MAKEUP
  VEHICLES
  SFX
  STUNTS
  ART
  EQUIPMENT
  LOCATION
  MISC
}

// --- Visual planning + production management (Phase D) ---
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewedVrfSubmissions VrfSubmission[] @relation("VrfReviewedBy")
  auditLogs              AuditLog[]
}

model Vendor {
  id      String @id @default(cuid())
  // Auto-generated on VRF approval or manual create, e.g. V-2026-0001
  vendorCode String @unique

  legalName      String
  tradeName      String?
  pan            String
  gstin          String[] @default([])
  placeOfSupply  String?
  placeOfInvoice String?
  msmeStatus     Boolean  @default(false)

  addressLine String?
  city        String?
  state       String?
  pincode     String?

  // Bank details: masked on read by lib/rbac.ts unless the viewer has Edit/Approve access.
  bankAccountNo   String
  bankName        String
  ifsc            String
  beneficiaryName String

  category      String
  paymentTerms  String?
  tdsSection    String?
  lowerTdsFlag  Boolean @default(false)
  defaultLedger String?

  status VendorStatus @default(ACTIVE)

  documents      VendorDocument[]
  vrfSubmission  VrfSubmission?
  purchaseOrders PurchaseOrder[]
  contacts       Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pan])
  @@index([status])
}

model VendorDocument {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  fileName   String
  expiryDate DateTime?
  uploadedAt DateTime     @default(now())

  @@index([vendorId])
}

// A vendor's self-submitted registration, reached only via `token` (no login).
model VrfSubmission {
  id           String  @id @default(cuid())
  token        String  @unique
  invitedEmail String?

  // Mirrors the Vendor fields above; kept as JSON until approval so a
  // rejected/edits-requested submission never touches the Vendor table.
  formData Json

  status         VrfStatus @default(PENDING)
  // Null until the vendor first submits the form; set again on each resubmit.
  submittedAt    DateTime?
  reviewerNotes  String?
  reviewedByUserId String?
  reviewedBy     User?     @relation("VrfReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt     DateTime?

  // Set once approved and the Vendor record is created from this submission.
  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  documents VrfDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VrfDocument {
  id              String        @id @default(cuid())
  vrfSubmissionId String
  vrfSubmission   VrfSubmission @relation(fields: [vrfSubmissionId], references: [id], onDelete: Cascade)
  type            DocumentType
  fileUrl         String
  fileName        String
  uploadedAt      DateTime      @default(now())

  @@index([vrfSubmissionId])
}

// Master list of content productions (Sheet 3: Project / Show Master).
model Project {
  id           String        @id @default(cuid())
  code         String        @unique // e.g. PRJ-2026-001
  title        String
  type         ProjectType
  genre        String?
  status       ProjectStatus @default(PRE_PRODUCTION)
  startDate    DateTime?
  endDate      DateTime?
  businessUnit String?
  producer     String?
  budgetOwnerUserId String?
  currency     String        @default("INR")
  commissioned Boolean       @default(false)

  // Imported script (single current file per project; Phase B).
  scriptFileUrl  String?
  scriptFileName String?

  budgets          BudgetHeader[]
  purchaseOrders   PurchaseOrder[]
  scenes           Scene[]
  locations        Location[]
  shootDays        ShootDay[]
  storyboardFrames StoryboardFrame[]
  moodBoardImages  MoodBoardImage[]
  tasks            Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A versioned budget for a project. At most one APPROVED header per project.
model BudgetHeader {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int
  status          BudgetStatus @default(DRAFT)
  notes           String?
  approvedByUserId String?
  approvedAt      DateTime?

  lines BudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}

model BudgetLine {
  id             String       @id @default(cuid())
  budgetHeaderId String
  budgetHeader   BudgetHeader @relation(fields: [budgetHeaderId], references: [id], onDelete: Cascade)
  department     String
  category       String
  ledger         String?
  description    String
  approvedAmount Decimal      @db.Decimal(14, 2)
  currency       String       @default("INR")
  sortOrder      Int          @default(0)

  poLines           PoLine[]
  breakdownElements BreakdownElement[]

  @@index([budgetHeaderId])
}

// Formal commitment to a vendor against a project's budget (Sheet 3: PO).
model PurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique // e.g. PO-2026-0001
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  status           PoStatus @default(DRAFT)
  deliveryDate     DateTime?
  notes            String?
  // Set when a Finance Head knowingly approves a PO that exceeds available budget.
  budgetOverride   Boolean  @default(false)
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?

  lines PoLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([vendorId])
  @@index([status])
}

model PoLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // The budget line this line commits against (Budget-vs-Actuals link).
  budgetLineId    String?
  budgetLine      BudgetLine?   @relation(fields: [budgetLineId], references: [id])
  description     String
  qty             Decimal       @db.Decimal(12, 2)
  rate            Decimal       @db.Decimal(14, 2)
  taxPct          Decimal?      @db.Decimal(5, 2)
  amount          Decimal       @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([budgetLineId])
}

// A scene from the script (Phase B: Script Breakdown).
model Scene {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String // "1", "12A" — free-form scene number
  intExt      SceneInt  @default(INT)
  setName     String // e.g. "Rahul's Apartment - Living Room"
  time        SceneTime @default(DAY)
  pageEighths Int? // page length in eighths of a page
  synopsis    String?
  sortOrder   Int       @default(0)

  // Schedule assignment (Phase C): which shoot day, and order within it.
  shootDayId String?
  shootDay   ShootDay? @relation(fields: [shootDayId], references: [id])
  dayOrder   Int?

  elements         BreakdownElement[]
  shots            Shot[]
  storyboardFrames StoryboardFrame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([shootDayId])
}

// A planned shot within a scene (Phase D: Shot Lists).
model Shot {
  id          String  @id @default(cuid())
  sceneId     String
  scene       Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  number      String // "1", "1A"
  shotSize    String? // WS / MS / CU …
  angle       String?
  movement    String? // static / pan / dolly …
  gear        String?
  description String?
  sortOrder   Int     @default(0)

  @@index([sceneId])
}

// A storyboard frame image (Phase D). Optionally tagged to a scene.
model StoryboardFrame {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId   String?
  scene     Scene?  @relation(fields: [sceneId], references: [id])
  imageUrl  String
  imageName String
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([projectId])
}

// A mood-board image (Phase D).
model MoodBoardImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  imageName String
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([projectId])
}

// A production task (Phase D: Task Boards / kanban).
model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assignee    String?
  dueDate     DateTime?
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A physical location for a project (Phase C).
model Location {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  contactName String?
  contactPhone String?
  dayCost     Decimal? @db.Decimal(14, 2)
  permitNote  String?
  notes       String?

  shootDays ShootDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Global crew / talent directory (people). Distinct from Vendor (payee); a
// contact may link to a Vendor when they are paid.
model Contact {
  id         String  @id @default(cuid())
  name       String
  role       String? // e.g. "DOP", "Gaffer", "Lead actor"
  department String?
  email      String?
  phone      String?
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])

  callSheetEntries ShootDayCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

// A shooting day in a project's schedule (Phase C).
model ShootDay {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dayNumber       Int
  date            DateTime?
  unit            String? // "Main Unit", "2nd Unit"
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  generalCallTime String? // "07:00"
  notes           String?

  scenes Scene[]
  crew   ShootDayCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, dayNumber])
  @@index([projectId])
}

// A crew/talent member called for a specific shoot day (call sheet row).
model ShootDayCrew {
  id         String   @id @default(cuid())
  shootDayId String
  shootDay   ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  callTime   String?
  note       String?

  @@unique([shootDayId, contactId])
  @@index([shootDayId])
}

// A tagged breakdown element within a scene (cast, prop, wardrobe, …).
model BreakdownElement {
  id            String          @id @default(cuid())
  sceneId       String
  scene         Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  category      ElementCategory
  name          String
  qty           Int             @default(1)
  notes         String?
  estimatedCost Decimal?        @db.Decimal(14, 2)
  // Optional link to the budget line this element's cost rolls into.
  budgetLineId  String?
  budgetLine    BudgetLine?     @relation(fields: [budgetLineId], references: [id])

  @@index([sceneId])
  @@index([budgetLineId])
}

// Immutable trail per Sheet 6's "Audit-first" principle.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
